# Multi-stage para construir app frontend (assume framework que gera /dist, ajuste conforme seu setup)
FROM node:24-alpine AS builder
WORKDIR /app

# Copia package.json do frontend
COPY package*.json ./
RUN npm i

COPY . .

# Ajuste comando de build conforme seu projeto (ex: npm run build / yarn build / pnpm build)
RUN npm run build

# Serve arquivos estáticos com nginx
FROM nginx:stable-alpine
COPY --from=builder /app/src/client/dist /usr/share/nginx/html

# Opcional: se quiser custom nginx config, adicione:
# COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]